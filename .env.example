# ---------------------------------------------------------------------------
# SynxHub — environment configuration
#
# Copy this file to `.env` for local development:
#   cp .env.example .env
#
# NEVER commit a real `.env` file. See README.md and docs/SECURITY.md for
# secret-management guidance in production (use your platform's secret
# manager — e.g. Vercel Environment Variables, AWS Secrets Manager, GCP
# Secret Manager — never a committed file).
# ---------------------------------------------------------------------------

# --- App -----------------------------------------------------------------

# Controls demo-data banners, mock provider usage, and fixture pricing.
# "development" or "production". Never accept real investor funds while
# this is anything other than "production" AND all providers below are
# real, reviewed integrations.
NODE_ENV="development"

# Public base URL of the deployment (no trailing slash).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Explicit demo-mode flag surfaced in the UI. Set to "false" only once real
# custody, KYC/AML, and payment integrations are live and legally reviewed.
NEXT_PUBLIC_DEMO_MODE="true"

# --- Database --------------------------------------------------------------

# PostgreSQL connection string.
# Local dev example: postgresql://postgres:postgres@localhost:5432/synxhub_dev
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/synxhub_dev"

# --- Auth (NextAuth / Auth.js) ---------------------------------------------

# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-32-byte-base64-secret"

# Google OAuth credentials. Create in Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {NEXT_PUBLIC_APP_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Enables the password-based credentials provider used ONLY for local
# development and automated tests when Google OAuth credentials are not
# configured. Must never be enabled in production.
ENABLE_DEV_CREDENTIALS_LOGIN="true"

# --- Application-layer encryption ------------------------------------------

# 32-byte (base64) key used to encrypt MFA secrets and other sensitive
# columns at rest (AES-256-GCM). Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY="replace-with-a-random-32-byte-base64-key"

# --- Custody / wallet provider integration ----------------------------------
# SynxHub never generates deposit addresses or signs withdrawals in
# frontend or ad-hoc backend code — all custody operations go through the
# provider abstraction in lib/deposits/provider.ts and
# lib/withdrawals/provider.ts. Set CUSTODY_PROVIDER=mock for local/dev use;
# a real integration (e.g. Fireblocks, BitGo, Copper) must implement the
# same interface and be reviewed by security before production use.
CUSTODY_PROVIDER="mock"
CUSTODY_API_KEY=""
CUSTODY_API_SECRET=""
CUSTODY_WEBHOOK_SECRET=""

# --- KYC / AML provider integration -----------------------------------------
# See lib/compliance/provider.ts. KYC_PROVIDER=mock is for development only.
# A real provider (e.g. Sumsub, Persona, ComplyAdvantage) must be integrated
# and legally reviewed before accepting real investor funds.
KYC_PROVIDER="mock"
KYC_API_KEY=""
KYC_WEBHOOK_SECRET=""

# --- Pricing feed ------------------------------------------------------------
# See lib/pricing/provider.ts. PRICING_PROVIDER=fixture serves clearly
# labeled DEMO DATA prices. A production deployment must configure a real
# market data provider.
PRICING_PROVIDER="fixture"
PRICING_API_KEY=""

# --- Rate limiting -----------------------------------------------------------
# In-memory rate limiting is used by default for local development. For a
# multi-instance production deployment, configure a shared store.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Observability -----------------------------------------------------------
SENTRY_DSN=""
